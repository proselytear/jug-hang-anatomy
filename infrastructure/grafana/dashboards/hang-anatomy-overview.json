{
  "uid": "hang-overview",
  "title": "Hang Anatomy - Overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": ["hang-anatomy", "overview"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"hang-anatomy-demo\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"hang-anatomy-demo\",status!~\"2..\"}[1m])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{application=\"hang-anatomy-demo\"}[1m])), 0.0001)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"hang-anatomy-demo\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99 latency by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"hang-anatomy-demo\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{application=\"hang-anatomy-demo\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory / heap",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"hang-anatomy-demo\",area=\"heap\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Restart proxy / process start",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "process_start_time_seconds{application=\"hang-anatomy-demo\"}"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Current demo mode",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "mimir"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (hang_demo_mode{application=\"hang-anatomy-demo\"})",
          "legendFormat": "{{mode}}"
        }
      ]
    }
  ]
}
